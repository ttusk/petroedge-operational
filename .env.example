# Operational service local development database settings.
POSTGRES_DB=operational
POSTGRES_USER=operational
POSTGRES_PASSWORD=operational_dev
POSTGRES_PORT=5432

GRPC_PORT=50051

# Used only by host-based development (`make run`); Compose overrides it internally.
DATABASE_URL=postgres://operational:operational_dev@localhost:5432/operational?sslmode=disable
GRPC_UI_PORT=8080
